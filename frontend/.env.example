# Environment Variables for Arcane Familiars Frontend
# Copy this file to .env and fill in your values
# See: https://docs.immutable.com/docs/zkevm/overview

# Infura Project ID for Ethereum RPC access (Goerli & Mainnet)
INFURA_API_KEY=your_infura_project_id_here

# Immutable X API endpoints
IMX_SANDBOX_URL=https://api.sandbox.x.immutable.com
IMX_MAINNET_URL=https://api.x.immutable.com

# Collection contract addresses
COLLECTION_CONTRACT_SANDBOX=0xb7eaa855fa6432d0597f297bace4613c33a075d1
COLLECTION_CONTRACT_MAINNET=0xacb3c6a43d15b907e8433077b6d38ae40936fe2c

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
