# Environment Variables for Arcane Familiars Frontend
# Copy this file to .env and fill in your values
# See: https://docs.immutable.com/docs/zkevm/overview

# Environment Variables for Arcane Familiars Frontend
# Vite exposes all VITE_ prefixed vars via import.meta.env
# Copy this file to .env and fill in your values

# Infura Project ID for Ethereum RPC access (Sepolia & Mainnet)
VITE_INFURA_API_KEY=your_infura_project_id_here

# Immutable X API endpoints
VITE_IMX_SANDBOX_URL=https://api.sandbox.x.immutable.com
VITE_IMX_MAINNET_URL=https://api.x.immutable.com

# Collection contract addresses
VITE_COLLECTION_CONTRACT_SANDBOX=0xb7eaa855fa6432d0597f297bace4613c33a075d1
VITE_COLLECTION_CONTRACT_MAINNET=0xacb3c6a43d15b907e8433077b6d38ae40936fe2c

# Backend API (Cloudflare Worker)
VITE_BACKEND_URL=http://localhost:8787

# Etherscan API key for contract verification
VITE_ETHERSCAN_API_KEY=your_etherscan_api_key_here
