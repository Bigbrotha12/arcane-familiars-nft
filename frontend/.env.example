# Environment Variables for Arcane Familiars Frontend
# Vite exposes all VITE_ prefixed vars via import.meta.env
# Copy this file to .env and fill in your values
# See: https://docs.immutable.com/docs/zkevm/overview
#
# Note: Only the variables below are consumed by frontend/game code.
# Never put API keys or secrets in a VITE_ var — Vite inlines all
# VITE_ prefixed vars into the client bundle. Server-side keys (Infura,
# Etherscan) belong in the backend Worker, not the frontend.

# Backend API (Cloudflare Worker)
VITE_BACKEND_URL=http://localhost:8787

# Immutable Passport Client ID (public, safe for client code)
# Create an application in the Immutable Hub to get your client id.
VITE_IMMUTABLE_CLIENT_ID=your_immutable_client_id_here

# Immutable environment: 'sandbox' or 'production' (defaults to sandbox)
VITE_IMMUTABLE_ENVIRONMENT=sandbox
