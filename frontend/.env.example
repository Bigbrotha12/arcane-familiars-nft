# Environment Variables for Arcane Familiars Frontend
# Vite exposes all VITE_ prefixed vars via import.meta.env.
#
# Never put API keys or secrets in a VITE_ var — Vite inlines all VITE_
# prefixed vars into the client bundle.

# Backend API (Cloudflare Worker)
VITE_BACKEND_URL=http://localhost:8787
