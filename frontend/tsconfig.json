{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@arcane-familiars/game": ["../game/src/index.ts"],
      "@arcane-familiars/game-logic": ["../packages/game-logic/src/index.ts"],
      "@/types/*": ["../packages/game-logic/src/types/*"],
      "@/data/*": ["../packages/game-logic/src/data/*"],
      "@/utils/*": ["../packages/game-logic/src/utils/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "vite-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
