{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcane-familiars-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Observability (WS5): logs + traces for the Worker. Matches the
  // Cloudflare dashboard's "sync local development" snippet, reconciled:
  // - top-level `enabled: true` is required per Workers Logs docs for logs to
  //   flow (the dashboard snippet's `enabled: false` was a serialization quirk);
  // - `redact_query_string` (API-only, unsupported by wrangler's schema) is set
  //   in the dashboard, not here.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": false,
      "head_sampling_rate": 1,
    },
  },
  // Local development uses its own D1 database (dev only, never remote).
  // Production uses [env.production] below, so `wrangler dev` and
  // `wrangler d1 ... --local` can never touch the production database.
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arcane-familiars-dev",
      "database_id": "65ee5652-56ec-42c9-b4a1-4953fc30d4d8",
      "migrations_dir": "./migrations",
    },
  ],
  "vars": {
    "ENVIRONMENT": "development",
  },
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arcane-familiars",
          "database_id": "02b17405-7ed9-4976-a3ef-d97efacf3b73",
          "migrations_dir": "./migrations",
          "remote": true,
        },
      ],
    },
    // Staging uses its own D1 database `arcane-familiars-staging` (created via
    // `wrangler d1 create arcane-familiars-staging`, authenticated). Remote only.
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arcane-familiars-staging",
          "database_id": "e9c91f6d-ced2-4590-b6e5-4ff03eddf704",
          "migrations_dir": "./migrations",
          "remote": true,
        },
      ],
    },
  },
}
