{
  "name": "arcane-familiars-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "types": "wrangler types",
    "build": "wrangler deploy --env production --dry-run",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply arcane-familiars-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply arcane-familiars --env production --remote",
    "db:migrate:staging": "wrangler d1 migrations apply arcane-familiars-staging --env staging --remote",
    "db:seed": "wrangler d1 execute arcane-familiars-dev --local --file ./seeds/0001_seed_familiars.sql",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@arcane-familiars/game-logic": "*",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.114.0"
  }
}
